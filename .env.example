# Copy to .env. Nothing here is required for the local (rdflib) mode.
SG_STORE=local                       # local | remote
SG_STAGING_URL=sqlite:///data/staging.db
# Remote triple store (GraphDB-style SPARQL protocol; UNVERIFIED against a live server)
SG_SPARQL_QUERY_URL=http://localhost:7200/repositories/suppliergraph
SG_SPARQL_UPDATE_URL=http://localhost:7200/repositories/suppliergraph/statements
SG_SPARQL_STATEMENTS_URL=http://localhost:7200/repositories/suppliergraph/statements
# LLM provider: anthropic | hf | openai_compat (unset: Anthropic if its key is set, else Hugging Face if HF_TOKEN is set)
SG_LLM_PROVIDER=
HF_TOKEN=                            # Hugging Face Inference Providers (router.huggingface.co/v1)
SG_LLM_BASE_URL=                     # openai_compat only, e.g. http://localhost:11434/v1 for Ollama
# For hf / openai_compat set a model id your provider serves, e.g. SG_LLM_MODEL=<org/model>
# LLM features (Ask tab, obligation extraction, eval)
ANTHROPIC_API_KEY=
SG_LLM_MODEL=claude-sonnet-5-5
SG_ALLOW_RAW_SPARQL=0
